@page
@model FeedbackApp.Pages.Admin.IndexModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Admin Dashboard";
    var request = HttpContextAccessor.HttpContext?.Request;
    var baseUrl = $"{request?.Scheme}://{request?.Host}";
}

<div class="fade-in">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Admin Dashboard 📊</h1>
        <p class="text-gray-600">Manage your events, questions, and view feedback</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6">
            <div class="text-3xl mb-2">📅</div>
            <div class="text-2xl font-bold text-gray-800">@Model.TotalEvents</div>
            <div class="text-gray-500 text-sm">Total Events</div>
        </div>
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6">
            <div class="text-3xl mb-2">🟢</div>
            <div class="text-2xl font-bold text-green-600">@Model.UpcomingEvents</div>
            <div class="text-gray-500 text-sm">Active Events</div>
        </div>
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6">
            <div class="text-3xl mb-2">💬</div>
            <div class="text-2xl font-bold text-purple-600">@Model.TotalFeedbacks</div>
            <div class="text-gray-500 text-sm">Total Responses</div>
        </div>
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6">
            <div class="text-3xl mb-2">⭐</div>
            <div class="text-2xl font-bold text-yellow-500">@(Model.OverallRating > 0 ? Model.OverallRating.ToString("0.0") : "-")</div>
            <div class="text-gray-500 text-sm">Avg Rating</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex flex-wrap gap-4 mb-8">
        <a asp-page="/Admin/Events/Create"
           class="inline-flex items-center bg-gradient-to-r from-pink-400 to-purple-500 text-white px-6 py-3 rounded-xl font-medium btn-cute hover:shadow-lg">
            ➕ Create New Event
        </a>
    </div>

    <!-- Events List -->
    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h2 class="text-xl font-bold text-gray-800">All Events</h2>
        </div>

        @if (Model.Events.Any())
        {
            <div class="divide-y divide-gray-100">
                @foreach (var evt in Model.Events)
                {
                    var avgRating = Model.GetAverageRating(evt.Id);
                    var feedbackCount = Model.GetFeedbackCount(evt.Id);
                    var isUpcoming = evt.Status == FeedbackApp.Models.EventStatus.Upcoming;
                    var shareLink = $"{baseUrl}/Feedback/Submit/{evt.ShareToken}";

                    <div class="p-6 hover:bg-gray-50 transition-colors">
                        <div class="flex flex-col gap-4">
                            <!-- Event Info Row -->
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @(isUpcoming ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                            @(isUpcoming ? "🟢 Active" : "⏰ Closed")
                                        </span>
                                        <span class="text-gray-400 text-sm">📅 @evt.EventDate.ToString("MMM dd, yyyy")</span>
                                        @if (evt.IncludeRating)
                                        {
                                            <span class="text-yellow-500 text-sm">⭐ Rating</span>
                                        }
                                        @if (evt.Questions.Any())
                                        {
                                            <span class="text-purple-500 text-sm">📋 @evt.Questions.Count Q</span>
                                        }
                                    </div>
                                    <h3 class="text-lg font-semibold text-gray-800">@evt.Name</h3>
                                    @if (!string.IsNullOrEmpty(evt.Description))
                                    {
                                        <p class="text-gray-500 text-sm mt-1 line-clamp-1">@evt.Description</p>
                                    }
                                </div>

                                <div class="flex items-center gap-6">
                                    <!-- Rating -->
                                    @if (evt.IncludeRating)
                                    {
                                        <div class="text-center">
                                            <div class="flex items-center">
                                                <span class="text-yellow-400">★</span>
                                                <span class="ml-1 font-semibold text-gray-700">
                                                    @(avgRating > 0 ? avgRating.ToString("0.0") : "-")
                                                </span>
                                            </div>
                                            <div class="text-xs text-gray-400">Rating</div>
                                        </div>
                                    }

                                    <!-- Feedback Count -->
                                    <div class="text-center">
                                        <div class="font-semibold text-gray-700">@feedbackCount</div>
                                        <div class="text-xs text-gray-400">Responses</div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex items-center gap-2">
                                        <a asp-page="/Admin/Events/Details" asp-route-id="@evt.Id"
                                           class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 transition-colors font-medium text-sm">
                                            👁️ View
                                        </a>
                                        <a asp-page="/Admin/Events/Edit" asp-route-id="@evt.Id"
                                           class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors font-medium text-sm">
                                            ✏️ Edit
                                        </a>
                                        <form method="post" asp-page-handler="DeleteEvent" asp-route-id="@evt.Id"
                                              onsubmit="return confirm('Are you sure you want to delete this event and all its feedback?');">
                                            <button type="submit"
                                                    class="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors font-medium text-sm">
                                                🗑️ Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Share Link Row -->
                            <div class="flex items-center gap-2 bg-gray-50 rounded-lg p-3">
                                <span class="text-gray-500 text-sm">🔗 Share Link:</span>
                                <input type="text" value="@shareLink" readonly
                                       class="flex-1 bg-transparent text-sm text-gray-600 outline-none"
                                       id="link-@evt.Id" />
                                <button type="button" onclick="copyLink('@evt.Id')"
                                        class="px-3 py-1 bg-purple-500 text-white rounded-lg text-sm hover:bg-purple-600 transition-colors">
                                    📋 Copy
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="p-12 text-center">
                <div class="text-6xl mb-4">🎪</div>
                <h3 class="text-xl font-bold text-gray-700 mb-2">No Events Yet</h3>
                <p class="text-gray-500 mb-6">Create your first event to start collecting feedback!</p>
                <a asp-page="/Admin/Events/Create"
                   class="inline-flex items-center bg-gradient-to-r from-pink-400 to-purple-500 text-white px-6 py-3 rounded-xl font-medium btn-cute hover:shadow-lg">
                    ➕ Create Your First Event
                </a>
            </div>
        }
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 bg-green-500 text-white px-6 py-3 rounded-xl shadow-lg transform translate-y-20 opacity-0 transition-all duration-300">
    Link copied to clipboard!
</div>

@section Scripts {
    <script>
        function copyLink(eventId) {
            const input = document.getElementById('link-' + eventId);
            input.select();
            document.execCommand('copy');

            // Show toast
            const toast = document.getElementById('toast');
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2000);
        }
    </script>
}
