@page "{id:guid}"
@model FeedbackApp.Pages.Admin.Events.DetailsModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = Model.Event?.Name ?? "Event Details";
    var request = HttpContextAccessor.HttpContext?.Request;
    var baseUrl = $"{request?.Scheme}://{request?.Host}";
}

<div class="fade-in">
    <!-- Back Button -->
    <a asp-page="/Admin/Index" class="inline-flex items-center text-gray-600 hover:text-purple-600 mb-6 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Dashboard
    </a>

    @if (Model.Event == null)
    {
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-8 text-center">
            <div class="text-6xl mb-4">❌</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Event Not Found</h2>
            <p class="text-gray-600">The event you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        var isUpcoming = Model.Event.Status == FeedbackApp.Models.EventStatus.Upcoming;
        var shareLink = $"{baseUrl}/Feedback/Submit/{Model.Event.ShareToken}";

        <!-- Event Header -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6 mb-6">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-4">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(isUpcoming ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                            @(isUpcoming ? "🟢 Active" : "⏰ Closed")
                        </span>
                        @if (Model.Event.IncludeRating)
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-yellow-100 text-yellow-700">
                                ⭐ Rating Enabled
                            </span>
                        }
                        @if (Model.Event.Questions.Any())
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-purple-100 text-purple-700">
                                📋 @Model.Event.Questions.Count Questions
                            </span>
                        }
                    </div>
                    <h1 class="text-2xl font-bold text-gray-800">@Model.Event.Name</h1>
                    @if (!string.IsNullOrEmpty(Model.Event.Description))
                    {
                        <p class="text-gray-600 mt-2">@Model.Event.Description</p>
                    }
                </div>
                <div class="flex items-center gap-6 text-center">
                    <div>
                        <div class="text-2xl font-bold text-gray-800">📅</div>
                        <div class="text-sm text-gray-500">@Model.Event.EventDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    @if (Model.Event.IncludeRating)
                    {
                        <div>
                            <div class="flex items-center justify-center text-2xl text-yellow-400">
                                ★ <span class="ml-1 text-gray-800 font-bold">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "-")</span>
                            </div>
                            <div class="text-sm text-gray-500">Avg Rating</div>
                        </div>
                    }
                    <div>
                        <div class="text-2xl font-bold text-purple-600">@Model.Feedbacks.Count()</div>
                        <div class="text-sm text-gray-500">Responses</div>
                    </div>
                </div>
            </div>

            <!-- Share Link -->
            <div class="flex items-center gap-2 bg-gray-50 rounded-lg p-3">
                <span class="text-gray-500 text-sm">🔗 Share Link:</span>
                <input type="text" value="@shareLink" readonly
                       class="flex-1 bg-transparent text-sm text-gray-600 outline-none"
                       id="share-link" />
                <button type="button" onclick="copyLink()"
                        class="px-3 py-1 bg-purple-500 text-white rounded-lg text-sm hover:bg-purple-600 transition-colors">
                    📋 Copy
                </button>
            </div>
        </div>

        <!-- Questions List (if any) -->
        @if (Model.Event.Questions.Any())
        {
            <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md p-6 mb-6">
                <h2 class="text-lg font-bold text-gray-800 mb-4">📋 Survey Questions</h2>
                <div class="space-y-2">
                    @foreach (var q in Model.Event.Questions.OrderBy(q => q.Order))
                    {
                        <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                            <span class="text-purple-500">Q@(q.Order + 1).</span>
                            <div class="flex-1">
                                <span class="text-gray-700">@q.Text</span>
                                @if (q.IsRequired)
                                {
                                    <span class="text-red-500 text-sm ml-1">*</span>
                                }
                                <span class="text-gray-400 text-xs ml-2">(@q.Type)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg mb-6">
                @TempData["Success"]
            </div>
        }

        <!-- Feedbacks List -->
        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-md overflow-hidden">
            <div class="p-6 border-b border-gray-100">
                <h2 class="text-xl font-bold text-gray-800">Feedback Responses 💬</h2>
            </div>

            @if (Model.Feedbacks.Any())
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var feedback in Model.Feedbacks)
                    {
                        <div class="p-6 hover:bg-gray-50 transition-colors">
                            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                                <div class="flex-1">
                                    <!-- Header -->
                                    <div class="flex items-center gap-3 mb-3">
                                        <div class="w-10 h-10 bg-gradient-to-br from-pink-400 to-purple-500 rounded-full flex items-center justify-center text-white font-bold">
                                            @feedback.DisplayName[0].ToString().ToUpper()
                                        </div>
                                        <div>
                                            <div class="font-semibold text-gray-800">@feedback.DisplayName</div>
                                            <div class="text-xs text-gray-400">@feedback.SubmittedAt.ToString("MMM dd, yyyy h:mm tt")</div>
                                        </div>
                                    </div>

                                    <!-- Rating (if applicable) -->
                                    @if (Model.Event.IncludeRating && feedback.Rating.HasValue)
                                    {
                                        <div class="flex items-center mb-3">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="text-lg @(i <= feedback.Rating ? "text-yellow-400" : "text-gray-300")">★</span>
                                            }
                                            <span class="ml-2 text-sm text-gray-600">(@feedback.Rating/5)</span>
                                        </div>
                                    }

                                    <!-- Question Answers -->
                                    @if (feedback.Answers.Any() && Model.Event.Questions.Any())
                                    {
                                        <div class="space-y-2 mb-3">
                                            @foreach (var q in Model.Event.Questions.OrderBy(q => q.Order))
                                            {
                                                var answer = feedback.Answers.GetValueOrDefault(q.Id.ToString(), "-");
                                                <div class="bg-purple-50 rounded-lg p-3">
                                                    <div class="text-xs text-purple-600 font-medium mb-1">@q.Text</div>
                                                    <div class="text-gray-700 text-sm">@(string.IsNullOrEmpty(answer) ? "-" : answer)</div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Comments -->
                                    @if (!string.IsNullOrWhiteSpace(feedback.Comments))
                                    {
                                        <div class="bg-gray-50 rounded-lg p-3">
                                            <div class="text-xs text-gray-500 mb-1">Additional Comments</div>
                                            <p class="text-gray-600">"@feedback.Comments"</p>
                                        </div>
                                    }
                                </div>

                                <!-- Delete Action -->
                                <form method="post" asp-page-handler="DeleteFeedback" asp-route-id="@Model.Event.Id" asp-route-feedbackId="@feedback.Id"
                                      onsubmit="return confirm('Are you sure you want to delete this feedback?');">
                                    <button type="submit"
                                            class="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors font-medium text-sm">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="p-12 text-center">
                    <div class="text-6xl mb-4">📭</div>
                    <h3 class="text-xl font-bold text-gray-700 mb-2">No Responses Yet</h3>
                    <p class="text-gray-500 mb-4">Share the link to start collecting feedback!</p>
                    <button onclick="copyLink()"
                            class="inline-flex items-center bg-gradient-to-r from-pink-400 to-purple-500 text-white px-6 py-3 rounded-xl font-medium btn-cute hover:shadow-lg">
                        📋 Copy Share Link
                    </button>
                </div>
            }
        </div>
    }
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-4 right-4 bg-green-500 text-white px-6 py-3 rounded-xl shadow-lg transform translate-y-20 opacity-0 transition-all duration-300">
    Link copied to clipboard!
</div>

@section Scripts {
    <script>
        function copyLink() {
            const input = document.getElementById('share-link');
            if (input) {
                input.select();
                document.execCommand('copy');

                const toast = document.getElementById('toast');
                toast.classList.remove('translate-y-20', 'opacity-0');
                setTimeout(() => {
                    toast.classList.add('translate-y-20', 'opacity-0');
                }, 2000);
            }
        }
    </script>
}
